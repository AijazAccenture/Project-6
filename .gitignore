# Terraform local working folder (provider plugins - large, re-downloadable)
.terraform/

# Terraform state files (can contain sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Override files (local-only changes)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Plan files
*.tfplan
tfplan

# Secrets and keys
.env
*.pem
*.key

# Editor / OS junk
*.swp
*~
.vscode/
.idea/
.DS_Store
Thumbs.db
